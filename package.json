{
  "name": "kbl-stats",
  "version": "0.1.0",
  "private": true,
  "description": "KBL 팬 스탯 대시보드 (비영리 팬 프로젝트)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fetch": "tsx scripts/fetch.ts",
    "fetch:all": "tsx scripts/fetch.ts --all",
    "process": "tsx scripts/process.ts",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.json",
    "test:metrics": "tsx tests/metrics.test.ts",
    "test:reference": "tsx tests/reference.test.ts",
    "test:leaders": "tsx tests/leaders.test.ts",
    "test": "npm run test:metrics && npm run test:leaders && npm run test:card && npm run test:player && npm run test:teams && npm run test:roster && npm run test:cardview && npm run test:highs && npm run test:badges && npm run test:gamelogs && npm run test:shots && npm run test:shotzones && npm run test:reference",
    "test:card": "tsx tests/card.test.ts",
    "prebuild": "tsx scripts/build-search-index.ts && tsx scripts/build-cards.ts && tsx scripts/build-shots.ts",
    "predev": "tsx scripts/build-search-index.ts && tsx scripts/build-cards.ts && tsx scripts/build-shots.ts",
    "build:shots": "tsx scripts/build-shots.ts",
    "build:search": "tsx scripts/build-search-index.ts",
    "test:player": "tsx tests/player.test.ts",
    "test:teams": "tsx tests/teams.test.ts",
    "build:cards": "tsx scripts/build-cards.ts",
    "test:roster": "tsx tests/roster.test.ts",
    "test:cardview": "tsx tests/cardview.test.ts",
    "test:highs": "tsx tests/highs.test.ts",
    "test:badges": "tsx tests/badges.test.ts",
    "backfill:highs": "tsx scripts/backfill-highs.ts",
    "backfill:gamelogs": "tsx scripts/backfill-gamelogs.ts",
    "test:gamelogs": "tsx tests/gamelogs.test.ts",
    "backfill:shots": "tsx scripts/backfill-shots.ts",
    "test:shots": "tsx tests/shots.test.ts",
    "test:shotzones": "tsx tests/shots-zones.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  }
}
