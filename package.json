{
  "name": "kbl-stats",
  "version": "0.1.0",
  "private": true,
  "description": "KBL 팬 스탯 대시보드 (비영리 팬 프로젝트)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fetch": "tsx scripts/fetch.ts",
    "fetch:all": "tsx scripts/fetch.ts --all",
    "process": "tsx scripts/process.ts",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.json",
    "test:metrics": "tsx tests/metrics.test.ts",
    "test:leaders": "tsx tests/leaders.test.ts",
    "test": "npm run test:metrics && npm run test:leaders && npm run test:card",
    "test:card": "tsx tests/card.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  }
}
