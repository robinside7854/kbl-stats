{
  // 수집·가공 스크립트(tsx로 실행)와 테스트 전용 설정. Next.js 화면은 tsconfig.json이 담당한다.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "jsx": "react"
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.tsx", "tests/**/*.ts", "lib/metrics.ts", "lib/types.ts"]
}
